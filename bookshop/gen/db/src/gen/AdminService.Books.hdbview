VIEW AdminService_Books AS SELECT
  Books_0.createdAt,
  Books_0.createdBy,
  Books_0.modifiedAt,
  Books_0.modifiedBy,
  Books_0.ID,
  Books_0.author_ID,
  Books_0.title,
  Books_0.descr,
  Books_0.genres_ID,
  Books_0.stock,
  Books_0.price,
  Books_0.isbn,
  Books_0.currency_code,
  Books_0.bpPublishier
FROM bookshop_com_co_Books AS Books_0