VIEW CatalogService_ListOfBooks AS SELECT
  Books_0.createdAt,
  Books_0.createdBy,
  Books_0.modifiedAt,
  Books_0.modifiedBy,
  Books_0.ID,
  Books_0.author_ID,
  Books_0.title,
  Books_0.genres_ID,
  Books_0.stock,
  Books_0.price,
  Books_0.isbn,
  currency_1.symbol AS currency,
  Books_0.bpPublishier
FROM (bookshop_com_co_Books AS Books_0 LEFT JOIN sap_common_Currencies AS currency_1 ON Books_0.currency_code = currency_1.code)