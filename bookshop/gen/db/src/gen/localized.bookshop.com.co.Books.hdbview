VIEW localized_bookshop_com_co_Books AS SELECT
  L_0.createdAt,
  L_0.createdBy,
  L_0.modifiedAt,
  L_0.modifiedBy,
  L_0.ID,
  L_0.author_ID,
  coalesce(localized_1.title, L_0.title) AS title,
  L_0.descr,
  L_0.genres_ID,
  L_0.stock,
  L_0.price,
  L_0.isbn,
  L_0.currency_code,
  L_0.bpPublishier
FROM (bookshop_com_co_Books AS L_0 LEFT JOIN bookshop_com_co_Books_texts AS localized_1 ON localized_1.ID = L_0.ID AND localized_1.locale = SESSION_CONTEXT('LOCALE'))