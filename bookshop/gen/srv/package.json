{
  "name": "bookshop",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap-cloud-sdk/util": "^4.5.1",
    "@sap/cds": "^9",
    "@sap/cds-common-content": "^3.1.0",
    "@sap/ux-ui5-tooling": "^1.22.0",
    "@sap/xssec": "^4",
    "@ui5/cli": "^4.0.50"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.2.0",
    "@sap/cds-dk": "^9",
    "sqlite3": "^6.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-mmbooks": "cds watch --open mmbooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-salesbooks": "cds watch --open salesbooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-mmlogisticabooks": "cds watch --open mmlogisticabooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-sales": "cds watch --open sales/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "sapux": [
    "app/sales"
  ],
  "cds": {
    "requires": {
      "auth": {
        "[sandbox]": {
          "kind": "mocked",
          "users": {
            "cesitar": {
              "password": "pass",
              "roles": [
                "admin"
              ]
            }
          }
        }
      },
      "BusinessPartnerA2X": {
        "kind": "odata-v2",
        "model": "srv/external/BusinessPartnerA2X",
        "[sandbox]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER"
          }
        }
      },
      "[production]": {
        "db": "hana",
        "auth": {
          "kind": "xsuaa"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}